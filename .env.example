# Server Configuration
SERVER_PORT=8080
SERVER_MODE=production
SERVER_HOST=0.0.0.0

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=x3ui
DATABASE_USER=x3ui
DATABASE_PASSWORD=changeme_secure_password
DATABASE_SSL_MODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# For SQLite (development only)
# DATABASE_TYPE=sqlite
# DATABASE_PATH=./data/x3ui.db

# Authentication & Security
JWT_SECRET=changeme_32_char_random_secret_key_here_minimum
JWT_REFRESH_SECRET=changeme_32_char_refresh_secret_key_here
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h
ENABLE_2FA=true
BCRYPT_COST=12

# Xray Configuration
XRAY_CONFIG_PATH=/etc/xray/config.json
XRAY_API_HOST=localhost
XRAY_API_PORT=10085
XRAY_ASSETS_PATH=/usr/local/share/xray

# Monitoring & Metrics
ENABLE_METRICS=true
ENABLE_WEBSOCKET=true
WEBSOCKET_PATH=/ws/monitor
METRICS_PATH=/metrics

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Session Configuration
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_PASSWORD=

# Application Defaults
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_EMAIL=admin@localhost

# Traffic Limits (defaults for new users)
DEFAULT_TRAFFIC_LIMIT=10737418240
DEFAULT_EXPIRY_DAYS=30
DEFAULT_IP_LIMIT=2

# Frontend Configuration (for build)
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8080/ws
